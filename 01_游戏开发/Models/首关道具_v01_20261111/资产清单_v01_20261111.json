  "task_contracts": {
    "F04": {
      "player": "单件拿放、递交、共享台暂存",
      "program": "原子转移单件所有权；满手拒收；失败保留源物件",
      "acceptance": "同帧争抢仅一人得到纸；共享台始终只占一格"
    },
    "F05": {
      "player": "空手按住抄纸",
      "program": "2秒工作量与可中断进度；唯一操作者；湿纸待取",
      "acceptance": "松手续做；未取湿纸不能产第二张"
    },
    "F06": {
      "player": "湿纸入指定挂位，等待后取干纸",
      "program": "双槽独立4秒计时；单张状态wet->dry",
      "acceptance": "A完成不影响B；第三张拒收；暂停冻结"
    },
    "F07": {
      "player": "干纸放印台并按住印刷",
      "program": "2秒工作量；绑定排序组合键；只在成功后切black",
      "acceptance": "湿纸拒收；黑票可见纸团和印桃、钱纹与票文，红印不可见"
    },
    "F08": {
      "player": "黑票放盖印台按住盖章",
      "program": "1秒工作量；成功一次启用red层；禁重复盖印",
      "acceptance": "同一朱印组只启用一次；black/red底纸与黑墨层不重复叠纸"
    },
    "F09": {
      "player": "手持朱票在窗口交付",
      "program": "立即消耗票、单次计分并更新订单；固定回执反馈",
      "acceptance": "黑票拒收；连续按键不重复消耗/计分；回执不是新物料"
    }
  },
